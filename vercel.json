{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "open-chessable",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/js/(.*)", "destination": "/web/js/$1" },
    { "source": "/css/(.*)", "destination": "/web/css/$1" },
    { "source": "/assets/(.*)", "destination": "/web/assets/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
